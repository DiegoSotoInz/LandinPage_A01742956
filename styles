/* HOJA DE ESTILOS UNIFICADA - HAIL MARY SINALOA 2026 (DARK THEME + HIGH-ANIMATION) */

:root {
    --bg-dark: #040711;
    --bg-card: #091024;
    --bg-card-hover: #101c3d;
    --primary-blue: #0055ff;
    --cyan-accent: #00d2ff;
    --cyan-glow: rgba(0, 210, 255, 0.4);
    --text-main: #ffffff;
    --text-muted: #94a3b8;
    --border-color: #1a2744;
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Rajdhani', sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    scroll-behavior: smooth;
}

body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    font-family: var(--font-body);
    font-size: 1.15rem;
    line-height: 1.6;
    overflow-x: hidden;
    position: relative;
}

/* EFECTO DE ESTRELLAS DE FONDO ANIMADAS */
body::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 200%;
    height: 200%;
    background: radial-gradient(1.5px 1.5px at 20px 30px, #ffffff, rgba(0,0,0,0)),
                radial-gradient(1.5px 1.5px at 40px 70px, #00d2ff, rgba(0,0,0,0)),
                radial-gradient(1px 1px at 90px 40px, #ffffff, rgba(0,0,0,0)),
                radial-gradient(2px 2px at 160px 120px, #0055ff, rgba(0,0,0,0));
    background-repeat: repeat;
    background-size: 200px 200px;
    opacity: 0.25;
    animation: spaceStars 60s linear infinite;
    z-index: -1;
}

@keyframes spaceStars {
    from { transform: translateY(0); }
    to { transform: translateY(-1000px); }
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
}

/* NAVBAR Y LOGOS DUALES */
.navbar {
    background-color: rgba(4, 7, 17, 0.92);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    transition: all 0.3s ease;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0;
}

.brand-group {
    display: flex;
    align-items: center;
    gap: 16px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo-svg {
    width: 48px;
    height: 48px;
    filter: drop-shadow(0 0 8px var(--cyan-accent));
    animation: floatLogo 4s ease-in-out infinite alternate;
}

.brand-divider {
    width: 1.5px;
    height: 38px;
    background: linear-gradient(to bottom, transparent, var(--cyan-accent), transparent);
    opacity: 0.6;
}

.partner-logo {
    display: flex;
    align-items: center;
}

